# 이 파일에는 실제 값을 절대 넣지 않습니다. 키 이름과 용도만 기록합니다.
# 로컬 개발: 이 파일을 복사해 .env.local(gitignore 처리됨)로 만들고 실제 값을 채우세요.
# Vercel 배포: 아래 값들을 프로젝트 Settings > Environment Variables에 환경(Development/Preview/Production)별로 등록하세요.

# ── 클라이언트 (Vite 빌드타임에 번들에 인라인됨 — 브라우저에 노출되어도 되는 값만) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TOSS_CLIENT_KEY=

# ── 회원가입 feature flag (전부 'true'일 때만 켜짐, 미설정=꺼짐) ──
# 시안이나 백엔드가 아직 확정되지 않은 가입 경로를 배포에서 숨기는 용도다.
# 값이 'true'가 아니면 라우트 자체가 등록되지 않거나 진입 시 /signup으로 되돌린다
# (각 화면이 이중으로 가드하므로 URL 직접 입력으로도 뚫리지 않는다).
#
# 만 14세 미만 가입 플로우(생년월일 → 법정대리인 인증 → 전용 폼).
# 법정대리인 본인확인(NICE)이 아직 스텁이라 켜면 데드엔드가 된다.
# src/pages/signup/StudentBirth.jsx, Under14Verify.jsx, Under14Form.jsx
VITE_UNDER14_SIGNUP_ENABLED=
# 학생 가입 완료 화면(C-2)의 자녀 연결 안내 노출.
# src/pages/signup/StudentComplete.jsx
VITE_CHILD_LINK_ENABLED=
# 학부모 가입 폼. 꺼져 있으면 "준비 중" 안내만 표시된다.
# 학부모 온보딩은 아직 src/pages/signup/parent/mockApi.js placeholder에 의존한다.
# src/pages/signup/parent/ParentForm.jsx
VITE_PARENT_SIGNUP_ENABLED=

# ── 서버 (api/ Vercel 서버리스 함수 전용 — 절대 클라이언트에 노출 금지) ──
# api/create-order.js, api/confirm-payment.js, api/create-service-ticket.js 의 Supabase 관리자 클라이언트
WINNING_SUPABASE_URL=
WINNING_SUPABASE_SERVICE_ROLE_KEY=
# 스쿨멘토 서버 로그인(api/auth/login.ts)이 GoTrue 비밀번호 로그인에 쓰는 프로젝트 secret key(sb_secret_...).
# Sb-Forwarded-For 헤더를 보내려면 해당 프로젝트에서 security_sb_forwarded_for_enabled 를 켜 둬야 한다.
SUPABASE_SECRET_KEY=
# api/confirm-payment.js 토스페이먼츠 결제 승인
TOSS_SECRET_KEY=
# api/create-service-ticket.js SSO 티켓 서명 시크릿 (32자 이상 필수)
SSO_SECRET=
# api/create-service-ticket.js 외부 연계 서비스 리다이렉트 대상 URL
# SUHAENG_SERVICE_URL 은 인앱 전환으로 폐기(2026-08-13) — 수행평가는 /app/performance로 직접 이동한다.
GOAL_SERVICE_URL=

# ── 수행평가 RAG 임베딩 (api/_lib/performance/embeddings.js, api/performance/admin-embed.js) ──
# Gemini API 키. 임베딩 생성에 쓰며 브라우저에는 절대 노출하지 않는다.
GEMINI_API_KEY=
# ⚠️ 아래 두 값은 이미 저장된 코퍼스와 반드시 일치해야 한다. 비워두면 코드 기본값
#   (gemini-embedding-2 / 768)을 쓰므로, 특별한 이유가 없으면 등록하지 않는 편이 안전하다.
#   winning_assessment_knowledge_items.embedding 은 vector(768) 이고 기존 행은 전부
#   gemini-embedding-2 의 출력이다. 차원이 다르면 insert 가 타입 에러로 즉시 터지지만,
#   모델만 다르면 **아무 에러 없이** 벡터 공간이 갈라져 코사인 유사도가 조용히 무의미해진다.
#   값을 바꾸는 것은 환경변수 토글이 아니라 코퍼스 전량 재임베딩
#   (POST /api/performance/admin-embed { action:'backfill', force:true } 반복 호출)을
#   동반하는 마이그레이션이다. 차원 변경은 컬럼 타입과 HNSW 인덱스 재생성까지 따라온다.
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSION=
# api/_lib/outbound.js 고정 IP 프록시 — 알리고·NICE의 발신 IP 화이트리스트를 통과하려면
# 외부 호출이 반드시 이 프록시를 경유해야 한다. Vercel Fixie 통합을 붙이면 FIXIE_URL은
# 자동 주입되므로 보통 직접 등록하지 않는다. 배포 환경에서 값이 없으면 호출이 즉시 실패한다
# (조용히 직접 나가면 벤더가 IP로 거절해 원인 파악이 어려워지므로 의도적으로 막는다).
FIXIE_URL=
# 다른 프록시로 갈아탈 때만 수동 지정 (FIXIE_URL보다 우선)
OUTBOUND_PROXY_URL=

# ── Vercel Cron (api/performance/cleanup-attachments.js) ──
# 이 저장소의 첫 cron이다(vercel.json `crons`는 직전까지 0건이었다).
# 스케줄은 vercel.json에 `0 18 * * *`(UTC) = KST 03:00 일 1회로 등록돼 있고,
# 안내문 첨부의 90일 보관 정책 집행 + 24시간 pending 고아 파일 스윕을 함께 돈다.
#
# 이 값이 프로젝트 환경변수에 있으면 Vercel이 cron 호출에 `Authorization: Bearer <값>`을
# 자동으로 실어 보낸다. 핸들러는 그 헤더가 일치할 때만 통과시킨다.
# ⚠️ **비워두면 cron이 전량 401로 거부된다**(fail-closed). 즉 값이 없으면 90일 자동 삭제
#   고지가 지켜지지 않는다 — Production 환경에 반드시 등록할 것.
#   반대로 통과시키는 설계였다면 누구나 호출해 남의 첨부를 지울 수 있으므로 이쪽이 맞다.
# 값은 충분히 긴 난수로 만든다: `openssl rand -hex 32`
CRON_SECRET=

# ── 휴대폰 인증 (api/send-phone-code.js, api/verify-phone-code.js) ──
# 인증번호 해시용 비밀키. 32자 이상. 6자리 숫자는 경우의 수가 100만뿐이라 단순 해시로는
# DB 덤프만으로 즉시 역산된다. 이 키로 HMAC을 걸며, 키는 DB에 두지 않는다.
# 이 값을 바꾸면 이미 발송된 인증번호는 전부 검증 불가가 된다.
PHONE_CODE_SECRET=
# 알리고 발송 계정
ALIGO_API_KEY=
ALIGO_USER_ID=
# 사전 등록된 발신번호
ALIGO_SENDER=
# 알림톡 발신프로필 키
ALIGO_SENDER_KEY=
# 알림톡 템플릿 코드 — 카카오 템플릿 심사 승인 후 발급된다.
# 아래는 인증번호 전용이다(api/_lib/aligo.ts sendVerificationCode).
ALIGO_TEMPLATE_CODE=
# 템플릿별 코드 (api/_lib/alimtalkTemplates.ts 의 codeEnv 와 1:1).
# 각 템플릿은 승인 문안과 **글자 단위로** 대조되므로, 알리고에서 문안을
# 수정했다면 코드뿐 아니라 그 파일의 본문도 함께 고쳐야 한다.
ALIGO_TPL_SIGNUP_COUPON=
ALIGO_TPL_DAILY_REPORT=
ALIGO_TPL_WEEKLY_REPORT=
ALIGO_TPL_MONTHLY_REPORT=
# 기본 채널은 알림톡이다. 'sms'라고 명시했을 때만 SMS로 나간다.
# 지금 sms로 둔 것은 위 ALIGO_TEMPLATE_CODE가 아직 없기 때문이며, 템플릿이
# 승인되면 코드를 채우고 이 줄을 지우면 알림톡으로 돌아온다.
# (알림톡은 failover='Y'라 카카오 미사용자에게는 알리고가 자동으로 SMS 대체 발송한다)
ALIGO_CHANNEL=sms
# 'true'면 알리고 테스트모드 — API는 호출하되 실제 발송·과금이 없다.
ALIGO_TEST_MODE=
# 'true'면 알리고를 아예 호출하지 않고 성공으로 처리한다. 개발 서버 IP가 알리고
# 화이트리스트에 없어 로컬에서 호출 자체가 막힐 때 쓴다.
# ⚠️ 인증번호가 서버 로그에 남으므로 운영에는 절대 등록하지 말 것.
ALIGO_DRY_RUN=
# 전역 일일 발송 상한 (기본 300). 번호·IP 한도를 모두 지키면서도 충분히 분산하면
# 잔액을 태울 수 있어 마지막 방어선으로 둔다.
PHONE_CODE_DAILY_GLOBAL_LIMIT=

# ── 본인확인 / NICE 「통합인증」 (api/_lib/niceIdentity.js, api/nice-identity-*.js) ──
# ⚠️ 상품을 헷갈리지 말 것. 우리 계약은 **통합인증**(auth.niceid.co.kr)이다.
# 구 「아이디 본인확인」(svc.niceapi.co.kr:22001)에 같은 자격증명을 보내면
# `GW_RSLT_CD 1702 Access is not allowed - Client ID + Client IP`가 돌아오는데,
# IP 문제처럼 보이지만 실제로는 "그 게이트웨이에 없는 client_id"라는 뜻이다.
# 발신 IP는 화이트리스트 대상이라 호출이 FIXIE_URL 프록시를 경유해야 한다(위 참고).
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
# 인증 완료 후 NICE가 사용자를 돌려보낼 콜백 URL.
# 반드시 api/nice-identity-callback 을 가리켜야 하며, 서버는 클라이언트가 보낸
# 값을 절대 쓰지 않는다(결과를 통째로 남의 서버로 보낼 수 있다).
# rid 쿼리를 붙인 최종 길이가 250byte를 넘으면 NICE가 거절한다.
# 사전 등록이 필요 없어 localhost도 그대로 통과한다 →
#   로컬: NICE_RETURN_URL=http://localhost:3000/api/nice-identity-callback
NICE_RETURN_URL=
# API 호스트 오버라이드 (선택). 비우면 https://auth.niceid.co.kr 를 쓴다.
NICE_API_BASE=
# 콜백이 postMessage targetOrigin으로 쓸 프론트 오리진 (선택).
# 비우면 NICE_RETURN_URL의 오리진을 쓰므로 보통 등록할 필요가 없다.
# 로컬에서 vercel dev로 붙일 때만 PUBLIC_SITE_URL=http://localhost:3000 처럼 지정한다.
PUBLIC_SITE_URL=

# ── Zoom 웹훅 (api/zoom-webhook.ts) ──
# 화상 상담 종료 시각을 받기 위한 이벤트 구독. 회의가 실제로 몇 분 진행됐는지는
# Zoom만 알 수 있어서 웹훅이 유일한 통보 경로다.
#
# Zoom App > Feature > Event Subscriptions 의 **Secret Token** 이다.
# ⚠️ 같은 화면의 Verification Token(구 방식)이 아니다 — 둘 다 있어서 헷갈리기 쉽고,
#   잘못 넣으면 엔드포인트 등록의 Validate 단계에서 서명 불일치로 떨어진다.
# ⚠️ 이 값이 등록될 환경(Preview/Production)과 Zoom에 등록한 콜백 URL의 환경이
#   같아야 한다. 프리뷰 URL로 검증하려면 Preview 스코프에도 넣어야 한다.
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── 레거시 이관 판정 (scripts/check-legacy-rowcounts.mjs, P0/P17 전용) ──
# 이관 대상 외부 앱(레거시, Supabase 프로젝트 ref orwngbyiylchpzufwvej)의 URL/서비스
# 롤 키. 이 스크립트로만 쓰며, 읽기 전용 count(*) 조회 후 값을 커밋하지 않는다.
# 없으면 스크립트가 에러 없이 "크리덴셜 없음" 안내만 출력하고 종료한다.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=

# ── 로컬 전용 (Vercel 등록 금지) ──
# 로컬 dev 서버 전용 관리자 권한 우회 플래그. Vercel(Preview/Production)에는 절대 등록하지 말 것.
VITE_ADMIN_BYPASS=
# 로컬 dev 서버 전용 유료 서비스 결제 게이트 우회 플래그(src/lib/paidServiceAccess.js).
# import.meta.env.DEV와 AND로 판정하므로 프로덕션 빌드에서는 값이 있어도 무시된다.
# 그래도 Vercel(Preview/Production)에는 등록하지 말 것.
# 역할: 유료 서비스 진입 CTA의 결제 확인·alert(로그인/결제 여부 확인)를 건너뛴다.
VITE_DISABLE_PAID_GATE=
# 로컬 dev 서버 전용 "이용권 보유 가정" 플래그(src/lib/entitlement.js).
# import.meta.env.DEV와 AND로 판정하므로 프로덕션 빌드에서는 값이 있어도 무시된다.
# 그래도 Vercel(Preview/Production)에는 등록하지 말 것.
# 역할: 이용권을 보유한 것으로 가정한다(마이페이지 결제 내역 등에 가짜 주문을 표시).
# VITE_DISABLE_PAID_GATE와 다르다 — 이건 CTA 진입 확인을 건너뛰는 것이고, 이건 이미
# 결제한 것처럼 보이게 하는 것이다.
# `npm run dev`(Vite 단독 실행)만 띄우면 api/ 서버리스 함수가 뜨지 않아
# /api/check-service-access가 존재하지 않는다 — 이 경우 src/lib/entitlement.js의
# hasEntitlement()는 항상 판정 불가(null)를 반환한다. 즉 로컬에서 목표관리(goal) 등
# 이용권 가드가 걸린 화면을 보려면 이 플래그가 사실상 필수다(vercel dev 등으로 api/까지
# 함께 띄우는 경우가 아니라면).
VITE_FAKE_ENTITLEMENT=
# 로컬 dev 서버 전용 "목표관리 온보딩(설문 7단계) 완료 가정" 플래그(src/lib/goalOnboarding.js).
# import.meta.env.DEV와 AND로 판정하므로 프로덕션 빌드에서는 값이 있어도 무시된다.
# 그래도 Vercel(Preview/Production)에는 등록하지 말 것.
# 역할: RequireGoalAccess의 3단계(온보딩 완료 판정)를 항상 통과시킨다. VITE_FAKE_ENTITLEMENT와
# 다르다 — 그건 "결제했다고 가정", 이건 "온보딩을 마쳤다고 가정"이다.
VITE_FAKE_ONBOARDING_DONE=
# 로컬 dev 서버 전용 이용권 게이트 우회 (서버 쪽, api/_lib/serviceAccess.js).
# VITE_FAKE_ENTITLEMENT는 클라이언트 진입 가드만 통과시킨다 — 서버는 이 값을
# 전혀 모르고, api/performance/*(bootstrap·session·recommend-topics 등 8곳)가
# hasPaidServiceAccess()로 그대로 403을 낸다. 이 플래그는 그 서버 판정을 우회한다.
# VITE_ 접두어를 쓰지 않는다 — Vite가 그 접두어를 클라이언트 번들에 심는데,
# 이 값은 서버 전용이라 번들에 들어가면 의미가 뒤집힌다.
# 프로덕션에서는 값이 'true'여도 절대 켜지지 않는다 — process.env.VERCEL_ENV나
# NODE_ENV가 'production'이면 앱 코드가 값을 보기도 전에 무조건 거부한다
# (Vercel이 배포 시 주입하는 값이라 앱 코드가 위조할 수 없다). 그래도
# Vercel(Preview/Production)에는 등록하지 말 것 — 로컬 .env.local 전용이다.
# 발동하면 program_access 행이 없는 사용자에 한해 meta.quota_total을 채우지
# 않은 채(= 차감 RPC가 무제한으로 폴백) 행을 자동 생성한다 — 기존 행은 손대지
# 않는다. 발동 시 매 호출마다 console.warn으로 로그를 남긴다.
# ⚠️ 범위는 수행평가가 아니라 전역이다 — hasPaidServiceAccess() 최상단에 걸려 있어
# SERVICE_CONFIGS의 모든 서비스(goal/target 포함)와 create-service-ticket·
# check-service-access까지 함께 우회한다. 켜 두면 목표관리 SSO 티켓도 미결제
# 계정에서 발급되니, 필요한 서비스만 확인했으면 다시 비워 둘 것.
DEV_BYPASS_ENTITLEMENT=
