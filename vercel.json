{
  "regions": ["icn1"],
  "rewrites": [
    {
      "source": "/services/goal/reports/:period/:reportId",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/performance/cleanup-attachments",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/performance/embed-session-vectors",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 23 28-31 * *"
    }
  ]
}
