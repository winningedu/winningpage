{
  "regions": ["icn1"],
  "rewrites": [
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$))admin/(?:knowledge-search/?))",
      "destination": "/api/app-30"
    },
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$))selfeval/(?:reports|session)/?)",
      "destination": "/api/app-30"
    },
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$))selfeval/(?:analyze)/?)",
      "destination": "/api/app-60"
    },
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$))admin/(?:knowledge-dedupe/?))",
      "destination": "/api/app-60"
    },
    {
      "source": "/api/(admin/knowledge-eval/?)",
      "destination": "/api/app-60"
    },
    {
      "source": "/api/(admin/premium-book/apply/?)",
      "destination": "/api/app-60"
    },
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$))admin(?:/.*)?)",
      "destination": "/api/app"
    },
    {
      "source": "/api/((?:goal/admin/cuts/backfill|growth/collect|growth/report|inquiry/evaluate-report|inquiry/plan-report|inquiry/recommend-topics|performance/admin-embed|performance/analyze-guide|performance/design-report|performance/evaluate|performance/recommend-topics|selfeval/finalize|selfeval/manual-logs|selfeval/pick-records|selfeval/report|selfeval/verify|selfeval/write)/?)",
      "destination": "/api/router-60"
    },
    {
      "source": "/api/((?!(?:.*/)?\\.\\.?(?:/|$)).*)",
      "destination": "/api/router"
    },
    {
      "source": "/services/goal/reports/:period/:reportId",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/performance/cleanup-attachments",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/performance/embed-session-vectors",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/growth-archive",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/growth-resume",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/selfeval-archive",
      "schedule": "10 19 * * *"
    },
    {
      "path": "/api/cron/inquiry-archive",
      "schedule": "20 19 * * *"
    },
    {
      "path": "/api/cron/ai-telemetry-cleanup",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/b2b-retention-purge",
      "schedule": "40 19 * * *"
    },
    {
      "path": "/api/cron/admin-uploads-tmp-cleanup",
      "schedule": "50 19 * * *"
    }
  ]
}
